      "targets": [
        {
          "rawSql": "SELECT merchant_name as Merchant, category as Category, COUNT(*) as Transactions, SUM(amount) as Total FROM transactions WHERE transaction_type='DEBIT' GROUP BY merchant_name, category ORDER BY Total DESC LIMIT 20;",
