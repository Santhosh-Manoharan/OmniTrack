      "targets": [
        {
          "rawSql": "SELECT transaction_date as time, SUM(amount) as amount FROM transactions WHERE transaction_type='DEBIT' AND transaction_date >= CURRENT_DATE - INTERVAL '30 days' GROUP BY transaction_date ORDER BY transaction_date;",
