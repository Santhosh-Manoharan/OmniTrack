{
  "name": "Monthly Reconciliation",
  "nodes": [
    {
      "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 9 28 * *" }] } },
      "id": "schedule",
      "name": "Monthly on 28th",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "http://paperless:8000/api/documents/",
        "headers": { "Authorization": "Token e61f76876d0bb609a95eba80bf3c81a75e702e15" },
        "qs": { "created__date__gte": "={{ $now.minus({months:1}).startOf('month').toFormat('yyyy-MM-dd') }}", "created__date__lte": "={{ $now.minus({months:1}).endOf('month').toFormat('yyyy-MM-dd') }}", "page_size": 500 }
      },
      "id": "fetch_docs",
      "name": "Fetch Month Documents",
      "type": "n8n-nodes-base.httpRequest",
      "position": [400, 300]
    },
    {
      "parameters": {
        "jsCode": "const docs = $input.first().json.results || [];\nconst summary = {\n  total_documents: docs.length,\n  categories: {},\n  month: $now.minus({months:1}).toFormat('MMMM yyyy')\n};\nfor (const doc of docs) {\n  const tags = doc.tags || [];\n  for (const tag of tags) {\n    summary.categories[tag] = (summary.categories[tag] || 0) + 1;\n  }\n}\nreturn [{ json: summary }];"
      },
      "id": "summarize",
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "position": [600, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "method": "POST",
        "body": "={\n  \"text\": \"📊 *Monthly Reconciliation Report*\\n\\n*Period:* {{ $json.month }}\\n*Total Documents:* {{ $json.total_documents }}\\n\\n*Breakdown:*\\n{{ Object.entries($json.categories).map(([k,v]) => '• ' + k + ': ' + v).join('\\n') }}\\n\\n<http://localhost:8000|View Paperless>\"\n}"
      },
      "id": "report",
      "name": "Send Report",
      "type": "n8n-nodes-base.httpRequest",
      "position": [800, 300]
    }
  ],
  "connections": {
    "Monthly on 28th": { "main": [[{ "node": "Fetch Month Documents", "type": "main", "index": 0 }]] },
    "Fetch Month Documents": { "main": [[{ "node": "Summarize", "type": "main", "index": 0 }]] },
    "Summarize": { "main": [[{ "node": "Send Report", "type": "main", "index": 0 }]] }
  }
}
