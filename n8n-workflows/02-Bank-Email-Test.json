{
  "name": "02-Bank-Email-Test",
  "nodes": [
    {
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [
        200,
        300
      ],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "ollama",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "position": [
        500,
        500
      ],
      "parameters": {
        "model": "mistral:7b",
        "options": {
          "temperature": 0.1
        }
      },
      "typeVersion": 1
    },
    {
      "id": "parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        700,
        500
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"title\": \"Bank Transaction\", \"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"amount\": {\"type\": \"number\"}, \"currency\": {\"type\": \"string\", \"enum\": [\"INR\", \"USD\", \"EUR\"]}, \"transaction_type\": {\"type\": \"string\", \"enum\": [\"DEBIT\", \"CREDIT\", \"TRANSFER\"]}, \"merchant_name\": {\"type\": [\"string\", \"null\"]}, \"merchant_upi\": {\"type\": [\"string\", \"null\"]}, \"bank_name\": {\"type\": \"string\"}, \"account_last4\": {\"type\": [\"string\", \"null\"]}, \"category\": {\"type\": \"string\", \"enum\": [\"groceries\", \"utilities\", \"transport\", \"food\", \"entertainment\", \"medical\", \"education\", \"rent\", \"shopping\", \"salary\", \"transfer\", \"fuel\", \"insurance\", \"emi\", \"other\"]}, \"date\": {\"type\": \"string\"}, \"time\": {\"type\": [\"string\", \"null\"]}}, \"required\": [\"amount\", \"currency\", \"transaction_type\", \"category\", \"date\"]}}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "llm",
      "name": "Test Bank Email Parse",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [
        500,
        300
      ],
      "parameters": {
        "text": "Email Date: Mon, 02 Jun 2026 14:30:00 +0530\nEmail Subject: Transaction Alert - Amount Debited\nEmail From: alerts@sbi.co.in\n\nEmail Content:\nDear Customer,\nYour a/c no. XXXX1234 is debited for Rs. 500.00 on 02-Jun-2026 14:30:00 towards UPI/P2A/1234567890/swiggyupi@axisbank/AXIS Bank.\nYour a/c balance is Rs. 15,230.50.\n- SBI",
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert financial data extraction assistant. Analyze the following Indian bank transaction notification email and extract ALL transactions. Return an array of transaction objects.\n\nRules:\n- Amount: numeric value only (remove Rs/INR/commas)\n- Merchant: clean brand name (swiggyupi@axisbank becomes Swiggy)\n- UPI ID: capture separately\n- Category: classify based on merchant\n- Return ONLY valid JSON array"
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "retryOnFail": true,
      "typeVersion": 1.6
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Test Bank Email Parse",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Test Bank Email Parse",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Structured Output Parser": {
      "ai_outputParser": [
        [
          {
            "node": "Test Bank Email Parse",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}