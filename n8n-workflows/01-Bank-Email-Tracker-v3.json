{
  "name": "01-Bank-Email-Tracker-v3",
  "nodes": [
    {
      "id": "trigger",
      "name": "Gmail Trigger - Bank Emails",
      "type": "n8n-nodes-base.gmailTrigger",
      "position": [200, 300],
      "parameters": {
        "simple": false,
        "filters": {
          "from": "@sbi.co.in,@hdfcbank.com,@icici.com,@bankofbaroda.com,@axisbank.com,@kotak.com,@indusind.com,@yesbank.in,@pnb.co.in,@canarabank.com",
          "subject": "debited,credited,transaction,payment,UPI,IMPS"
        },
        "options": {
          "downloadAttachments": true
        },
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GMAIL_CRED",
          "name": "Gmail OAuth2"
        }
      },
      "typeVersion": 1.1
    },
    {
      "id": "set_data",
      "name": "Prepare Email Data",
      "type": "n8n-nodes-base.set",
      "position": [450, 300],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "email_date",
              "type": "string",
              "value": "={{ $json.date }}"
            },
            {
              "name": "email_subject",
              "type": "string",
              "value": "={{ $json.subject }}"
            },
            {
              "name": "email_from",
              "type": "string",
              "value": "={{ $json.from.text }}"
            },
            {
              "name": "email_text",
              "type": "string",
              "value": "={{ $json.textAsHtml }}"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "api",
      "name": "Parse & Insert Transaction",
      "type": "n8n-nodes-base.httpRequest",
      "position": [700, 300],
      "parameters": {
        "url": "http://transaction-api:8090/transactions/from-email",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { email_text: $json.email_text, email_from: $json.email_from, email_subject: $json.email_subject, email_date: $json.email_date } }}",
        "options": {
          "timeout": 120000
        }
      },
      "typeVersion": 4.4
    },
    {
      "id": "paperless",
      "name": "Store in Paperless",
      "type": "n8n-nodes-base.httpRequest",
      "position": [950, 300],
      "parameters": {
        "url": "http://upload-helper:8888/upload",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { title: 'Bank Txn: ' + $json.email_subject + ' (' + $json.email_date + ')', content: 'From: ' + $json.email_from + '\\nSubject: ' + $json.email_subject + '\\nDate: ' + $json.email_date + '\\n\\n' + $json.email_text } }}",
        "options": {
          "timeout": 30000
        }
      },
      "typeVersion": 4.4
    }
  ],
  "connections": {
    "Gmail Trigger - Bank Emails": {
      "main": [
        [
          {
            "node": "Prepare Email Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Email Data": {
      "main": [
        [
          {
            "node": "Parse & Insert Transaction",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse & Insert Transaction": {
      "main": [
        [
          {
            "node": "Store in Paperless",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
