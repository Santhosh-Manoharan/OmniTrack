{
  "name": "GPay Email Tracker",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "minutesInterval": 5 }] },
        "filters": { "from": "pay-noreply@google.com" }
      },
      "id": "trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "position": [200, 300],
      "credentials": { "gmailOAuth2": { "id": "GMAIL_CREDENTIAL" } }
    },
    {
      "parameters": {
        "url": "http://ollama:11434/api/generate",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"mistral:7b\",\n  \"prompt\": \"Parse this Google Pay transaction email and return ONLY a valid JSON object with these exact keys: amount (number), payee (string), type (debit or credit or transfer), date (YYYY-MM-DD), category (groceries/transport/entertainment/medical/utilities/shopping/food/transfer/salary/other), description (brief one line). Do not include any explanation.\\n\\nEmail subject: {{ $('Gmail Trigger').first().json.subject }}\\n\\nEmail body: {{ $('Gmail Trigger').first().json.text }} <= does not work if no plain text, use .json.body for html\",\n  \"stream\": false,\n  \"options\": { \"temperature\": 0.1, \"num_predict\": 200 }\n}",
        "options": { "timeout": 60000 }
      },
      "id": "ollama",
      "name": "Ollama Parse Email",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "http://upload-helper:8888/upload",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"title\": \"Transaction: {{ JSON.parse($json.response).payee }} - {{ JSON.parse($json.response).type }} ₹{{ JSON.parse($json.response).amount }}\",\n  \"content\": \"Subject: {{ $('Gmail Trigger').first().json.subject }}\\nBody: {{ $('Gmail Trigger').first().json.text }}\\n\\nParsed: {{ $json.response }}\"\n}",
        "options": { "timeout": 30000 }
      },
      "id": "paperless",
      "name": "Store in Paperless",
      "type": "n8n-nodes-base.httpRequest",
      "position": [700, 300]
    }
  ],
  "connections": {
    "Gmail Trigger": { "main": [[{ "node": "Ollama Parse Email", "type": "main", "index": 0 }]] },
    "Ollama Parse Email": { "main": [[{ "node": "Store in Paperless", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
