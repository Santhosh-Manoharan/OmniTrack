{
  "name": "02-Bank-Email-Test-v4",
  "nodes": [
    {
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "position": [200, 300],
      "parameters": {},
      "typeVersion": 1
    },
    {
      "id": "set_sample",
      "name": "Sample Bank Email",
      "type": "n8n-nodes-base.set",
      "position": [400, 300],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "email_text",
              "type": "string",
              "value": "Dear Customer, Your a/c no. XXXX1234 is debited for Rs. 500.00 on 02-Jun-2026 14:30:00 towards UPI/P2A/1234567890/swiggyupi@axisbank/AXIS Bank. Your a/c balance is Rs. 15,230.50. - State Bank of India"
            },
            {
              "name": "email_from",
              "type": "string",
              "value": "alerts@sbi.co.in"
            },
            {
              "name": "email_subject",
              "type": "string",
              "value": "Transaction Alert - Amount Debited"
            },
            {
              "name": "email_date",
              "type": "string",
              "value": "2026-06-02"
            }
          ]
        }
      },
      "typeVersion": 3.4
    },
    {
      "id": "api",
      "name": "Parse & Insert via API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 300],
      "parameters": {
        "url": "http://transaction-api:8090/transactions/from-email",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { email_text: $json.email_text, email_from: $json.email_from, email_subject: $json.email_subject, email_date: $json.email_date } }}",
        "options": {
          "timeout": 120000
        }
      },
      "typeVersion": 4.4
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Sample Bank Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sample Bank Email": {
      "main": [
        [
          {
            "node": "Parse & Insert via API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
